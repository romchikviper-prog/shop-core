@startuml
!include lib/C4_Context.puml

title Контекстна діаграма (C4, рівень 1) — інтернет-магазин електроніки

Person(customer, "Покупець", "Обирає товари, оформлює замовлення та оплачує їх")
Person(manager, "Менеджер магазину", "Керує замовленнями, відправленнями та залишками")

System(shop, "Інтернет-магазин електроніки", "Каталог, кошик, оформлення замовлень, оплата, резервування залишків, відстеження доставки")

System_Ext(payment, "Платіжний шлюз", "Авторизує та списує кошти; підтримує idempotency key")
System_Ext(delivery, "Служба доставки", "Створює відправлення та надає трекінг")

Rel(customer, shop, "Переглядає каталог, оформлює й оплачує замовлення", "HTTPS/JSON")
Rel(manager, shop, "Керує замовленнями й відправленнями", "HTTPS/JSON")
Rel(shop, payment, "Списує кошти, передає idempotency key", "HTTPS/REST")
Rel(shop, delivery, "Створює відправлення, отримує трекінг", "HTTPS/REST")

LAYOUT_TOP_DOWN()
@enduml
